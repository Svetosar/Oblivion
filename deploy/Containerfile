ARG GO_VERSION=1.27
FROM docker.io/library/golang:${GO_VERSION} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w" -o /out/oblivion ./cmd/oblivion

FROM scratch
COPY --from=build /out/oblivion /oblivion
# Non-root, numeric uid so it works in scratch. Mount a volume at /data
# (rootless podman: add the :U flag so ownership matches).
USER 65532:65532
ENV OBLIVION_DATA_DIR=/data OBLIVION_LISTEN=0.0.0.0:8080 OBLIVION_LOG_JSON=true GOMEMLIMIT=256MiB
EXPOSE 8080
ENTRYPOINT ["/oblivion"]
