# Base images are pinned by digest (supply chain). To update: pull the tag, read
# `podman image inspect <img> --format '{{index .RepoDigests 0}}'`, paste here.
FROM docker.io/library/node:22@sha256:1a81f3fd55b56c8fe964333a05bd1f257450b914a1196eb8bd577374900a1f70 AS admin
WORKDIR /src/admin
COPY admin/package.json admin/package-lock.json ./
RUN npm ci
COPY admin/ ./
# vite writes to ../internal/admin/dist
RUN npm run build

FROM docker.io/library/golang:1.27@sha256:87f49b77a7b6a99ad7dc656be010ae453322459dd2ed902ac177649a302bc101 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=admin /src/internal/admin/dist/ internal/admin/dist/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags "-s -w" -o /out/oblivion ./cmd/oblivion
# An empty data directory owned by the runtime user: a fresh named volume mounted
# at /data inherits this ownership, so no :U flag and no chown are needed.
RUN mkdir /out/data && chown 65532:65532 /out/data

FROM scratch
COPY --from=build /out/oblivion /oblivion
COPY --from=build --chown=65532:65532 /out/data /data
# Non-root, numeric uid so it works in scratch. Mount a named volume at /data.
USER 65532:65532
ENV OBLIVION_DATA_DIR=/data OBLIVION_LISTEN=0.0.0.0:8080 OBLIVION_LOG_JSON=true GOMEMLIMIT=256MiB
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD ["/oblivion", "healthcheck"]
ENTRYPOINT ["/oblivion"]
